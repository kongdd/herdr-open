#!/usr/bin/env bash
set -euo pipefail
# Prevent Git Bash from rewriting remote POSIX paths passed to native CLIs.
export MSYS_NO_PATHCONV=1

fail() {
    printf 'herdr-open: %s\n' "$*" >&2
    exit 1
}

editor() {
    [[ $1 == zed || $1 == code ]] || fail 'editor must be zed or code'
}

path_valid() {
    local controls=$'[\001-\037\177]'
    [[ $1 == /* && $1 != *$controls* ]] ||
        fail 'expected an absolute path without control characters'
}

host_valid() {
    [[ $1 =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.@-]*$ ]] ||
        fail 'use an SSH config alias or user@host'
}

launch() {
    local ed=$1 host=$2 path=$3 bin
    editor "$ed"
    path_valid "$path"
    [[ -z $host ]] || host_valid "$host"

    case $ed in
        zed)
            bin=${HERDR_OPEN_ZED_BIN:-zed}
            if [[ -n $host ]]; then
                path="ssh://$host$(jq -rn --arg p "$path" '
                    $p | split("/") | map(@uri) | join("/")
                ')"
            fi
            "$bin" "$path"
            ;;
        code)
            bin=${HERDR_OPEN_CODE_BIN:-code}
            if [[ -n $host ]]; then
                "$bin" --remote "ssh-remote+$host" "$path"
            else
                "$bin" "$path"
            fi
            ;;
    esac
}

request() {
    local ed=$1 path fifo message writer timer status=0
    editor "$ed"
    path=$(jq -er '
        [.worktree.checkout_path, .workspace_cwd, .focused_pane_cwd]
        | map(select(type == "string" and length > 0))
        | first
    ' <<< "${HERDR_PLUGIN_CONTEXT_JSON:?run through a Herdr plugin action}")
    path_valid "$path"
    fifo=${HERDR_PLUGIN_CONFIG_DIR:?}/relay/requests

    if [[ ! -p $fifo ]]; then
        [[ -z ${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-} ]] ||
            fail 'remote session needs a local herdr-open-relay HOST'
        launch "$ed" '' "$path"
        return
    fi

    message=$(jq -cn --arg editor "$ed" --arg path "$path" '{editor:$editor,path:$path}')
    # Stay below POSIX PIPE_BUF so simultaneous writes cannot interleave.
    [[ $(LC_ALL=C printf '%s\n' "$message" | wc -c) -le 512 ]] ||
        fail 'remote request exceeds 512 bytes'

    (printf '%s\n' "$message" > "$fifo") &
    writer=$!
    (sleep 3; kill "$writer" 2>/dev/null || :) &
    timer=$!
    wait "$writer" || status=$?
    kill "$timer" 2>/dev/null || :
    wait "$timer" 2>/dev/null || :
    [[ $status == 0 ]] || fail 'relay unavailable; restart herdr-open-relay HOST'
}

case ${1:---help} in
    open)
        [[ $# == 2 ]] || fail 'usage: herdr-open open zed|code'
        request "$2"
        ;;
    local)
        [[ $# == 3 ]] || fail 'usage: herdr-open local zed|code /path'
        launch "$2" '' "$3"
        ;;
    remote)
        [[ $# == 4 ]] || fail 'usage: herdr-open remote zed|code HOST /path'
        launch "$2" "$3" "$4"
        ;;
    --help|-h)
        printf '%s\n' \
            'herdr-open open zed|code' \
            'herdr-open local zed|code /path' \
            'herdr-open remote zed|code HOST /path'
        ;;
    *)
        fail 'invalid arguments; run herdr-open --help'
        ;;
esac
